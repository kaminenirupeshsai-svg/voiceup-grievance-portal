<!doctype html>
<html lang="en">
<head>
  <title>Resolved History — VoiceUp</title>
  <%- include('partials/head') %>
</head>

<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>Resolved Complaints</h1>
        <div class="sub"><%= complaints.length %> resolved</div>
      </header>

      <div class="app-content">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Ref</th><th>Title</th><th>Student</th><th>Category</th><th>Status</th><th>Resolved</th>
              </tr>
            </thead>
            <tbody>
              <% if (complaints.length === 0) { %>
                <tr><td colspan="6"><div class="empty-state"><i class="bi bi-inbox icon"></i><h4>No resolved complaints yet</h4></div></td></tr>
              <% } %>
              <% complaints.forEach(c => { %>
                <tr>
                  <td><%= c.referenceId %></td>
                  <td><strong><%= c.title %></strong></td>
                  <td><%= c.anonymous ? "Anonymous" : c.student?.name %></td>
                  <td><%= c.category %></td>
                  <td><span class="badge resolved"><%= c.status %></span></td>
                  <td><%= c.resolvedAt ? new Date(c.resolvedAt).toLocaleString() : new Date(c.updatedAt).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
