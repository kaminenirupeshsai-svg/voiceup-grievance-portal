<!doctype html>
<html lang="en">
<head>
  <title>Grievance Cell — VoiceUp</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>Grievance Queue</h1>
        <div class="sub"><%= complaints.length %> awaiting action</div>
      </header>

      <div class="app-content">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th>Ref</th><th>Title</th><th>Category</th><th>Student</th><th>Description</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% if (complaints.length === 0) { %>
                <tr><td colspan="7"><div class="empty-state"><i class="bi bi-inbox icon"></i><h4>Queue is empty</h4><p>Nothing needs your attention right now.</p></div></td></tr>
              <% } %>
              <% complaints.forEach(c => { %>
                <tr>
                  <td><%= c.referenceId %></td>
                  <td><strong><%= c.title %></strong></td>
                  <td><%= c.category %></td>
                  <td><%= c.anonymous ? "Anonymous" : (c.student ? c.student.name : '—') %></td>
                  <td style="max-width:260px"><span class="small"><%= (c.description||'').slice(0,90) %><%= c.description && c.description.length>90 ? '…' : '' %></span></td>
                  <td>
                    <% if (c.status === 'In Process') { %><span class="badge inprocess">In Process</span>
                    <% } else { %><span class="badge pending">Pending</span><% } %>
                  </td>
                  <td>
                    <div class="row" style="flex-wrap:wrap;gap:6px">
                      <form method="POST" action="/grievance/review">
                        <input type="hidden" name="id" value="<%= c._id %>">
                        <button class="btn secondary small" type="submit">Review</button>
                      </form>
                      <form method="POST" action="/grievance/forward">
                        <input type="hidden" name="id" value="<%= c._id %>">
                        <button class="btn small" type="submit">Forward</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
