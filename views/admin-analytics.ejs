<!doctype html>
<html lang="en">
<head>
  <title>Analytics — VoiceUp</title>
  <%- include('partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>Analytics Overview</h1>
        <div class="sub"><%= totalComplaints %> total complaints</div>
      </header>

      <div class="app-content">
        <div class="stat-grid">
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon"><i class="bi bi-collection"></i></span>Total Complaints</div>
            <div class="stat-value"><%= totalComplaints %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon"><i class="bi bi-stopwatch"></i></span>Avg Resolution Time</div>
            <div class="stat-value"><%= avgResolutionHours ? Math.round(avgResolutionHours) + 'h' : '—' %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon" style="background:#fef3c7;color:#b45309"><i class="bi bi-star-fill"></i></span>Avg Satisfaction</div>
            <div class="stat-value"><%= avgRating ? avgRating.toFixed(1) + ' / 5' : '—' %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon"><i class="bi bi-chat-left-text"></i></span>Ratings Submitted</div>
            <div class="stat-value"><%= ratingCount %></div>
          </div>
        </div>

        <div class="grid-2">
          <div class="card"><h3>Complaints — Last 30 Days</h3><canvas id="trendChart" height="110"></canvas></div>
          <div class="card"><h3>By Status</h3><canvas id="statusChart" height="110"></canvas></div>
        </div>

        <div class="grid-2" style="margin-top:16px">
          <div class="card"><h3>By Category</h3><canvas id="categoryChart" height="110"></canvas></div>
          <div class="card"><h3>Avg Resolution Time by Category (hrs)</h3><canvas id="resolutionChart" height="110"></canvas></div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const trend = JSON.parse(`<%- JSON.stringify(trend) %>`);
    const statusData = JSON.parse(`<%- JSON.stringify(statusCounts) %>`);
    const categoryData = JSON.parse(`<%- JSON.stringify(categoryCounts) %>`);
    const resolutionData = JSON.parse(`<%- JSON.stringify(resolutionByCategory) %>`);

    const palette = ['#4f46e5', '#0ea5e9', '#f59e0b', '#10b981', '#ef4444', '#8b5cf6'];

    new Chart(document.getElementById('trendChart'), {
      type: 'line',
      data: {
        labels: trend.map(t => t._id),
        datasets: [{ label: 'Complaints filed', data: trend.map(t => t.count), borderColor: '#4f46e5', backgroundColor: 'rgba(79,70,229,0.1)', fill: true, tension: 0.3 }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });

    new Chart(document.getElementById('statusChart'), {
      type: 'doughnut',
      data: {
        labels: statusData.map(s => s._id || 'Unknown'),
        datasets: [{ data: statusData.map(s => s.count || 0), backgroundColor: palette }]
      },
      options: { responsive: true }
    });

    new Chart(document.getElementById('categoryChart'), {
      type: 'bar',
      data: {
        labels: categoryData.map(c => c._id || 'Unknown'),
        datasets: [{ label: 'Complaints', data: categoryData.map(c => c.count || 0), backgroundColor: '#4f46e5', borderRadius: 6 }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });

    new Chart(document.getElementById('resolutionChart'), {
      type: 'bar',
      data: {
        labels: resolutionData.map(r => r._id || 'Unknown'),
        datasets: [{ label: 'Avg hours', data: resolutionData.map(r => Math.round(r.avgHours)), backgroundColor: '#0ea5e9', borderRadius: 6 }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
  </script>
</body>
</html>
