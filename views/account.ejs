<!doctype html>
<html lang="en">
<head>
  <title>Account Settings — VoiceUp</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>Account Settings</h1>
        <div class="sub">Update your profile details</div>
      </header>

      <div class="app-content" style="max-width:560px">
        <div class="card">
          <form method="POST" action="/auth/update-profile">
            <div class="form-row">
              <label>Name</label>
              <input type="text" name="name" value="<%= user.name %>" required>
            </div>

            <div class="form-row">
              <label>Roll Number</label>
              <input type="text" value="<%= user.roll %>" disabled>
              <div class="help-text">Roll number cannot be changed.</div>
            </div>

            <div class="form-row">
              <label>Department</label>
              <input type="text" name="department" value="<%= user.department %>" required>
            </div>

            <div class="form-row">
              <label>Email</label>
              <input type="email" name="email" value="<%= user.email %>" required>
            </div>

            <div class="form-row">
              <label>Change Password (optional)</label>
              <input type="password" name="password" placeholder="Leave blank if unchanged">
            </div>

            <button class="btn" type="submit"><i class="bi bi-check-lg"></i> Update Profile</button>
            <a class="btn secondary" href="/dashboard">Cancel</a>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
