<!doctype html>
<html lang="en">
<head>
  <title>Grievance Cell Login — VoiceUp</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="auth-icon" style="background:var(--accent)"><i class="bi bi-megaphone"></i></div>
      <h2>Grievance Cell Login</h2>
      <p class="lead">Triage and forward complaints to the right team</p>

      <form method="POST" action="/auth/login-grievance">
        <div class="form-row">
          <label>Email</label>
          <input name="email" type="email" placeholder="grievance@college.edu" required>
        </div>
        <div class="form-row">
          <label>Password</label>
          <input name="password" type="password" placeholder="Enter password" required>
        </div>
        <button class="btn" type="submit">Login</button>
      </form>

      <a class="auth-back" href="/">← Back to Home</a>
    </div>
  </div>
</body>
</html>
