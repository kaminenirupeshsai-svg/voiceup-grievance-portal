<!doctype html>
<html lang="en">
<head>
  <title>Officer Dashboard — VoiceUp</title>
  <%- include('partials/head') %>
</head>

<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>Escalated Queue</h1>
        <div class="sub"><%= complaints.length %> awaiting resolution</div>
      </header>

      <div class="app-content">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Ref</th><th>Title</th><th>Student</th><th>Category</th><th>Status</th><th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (complaints.length === 0) { %>
                <tr><td colspan="6"><div class="empty-state"><i class="bi bi-inbox icon"></i><h4>No escalated complaints</h4></div></td></tr>
              <% } %>
              <% complaints.forEach(c => { %>
                <tr>
                  <td><%= c.referenceId %></td>
                  <td><strong><%= c.title %></strong></td>
                  <td><%= c.anonymous ? "Anonymous" : c.student?.name %></td>
                  <td><%= c.category %></td>
                  <td><span class="badge escalated"><%= c.status %></span></td>
                  <td>
                    <div class="row" style="flex-wrap:wrap;gap:6px">
                      <button class="btn secondary small" onclick="openDetails('<%= c._id %>')">View</button>
                      <form method="POST" action="/officer/resolve">
                        <input type="hidden" name="id" value="<%= c._id %>">
                        <button class="btn small" type="submit">Resolve</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- DETAILS MODAL -->
  <div id="detailsModal" class="modal-backdrop">
    <div class="modal-box">
      <span class="modal-close" onclick="closeDetails()">&times;</span>
      <h3>Complaint Details</h3>
      <div id="detailsArea">Loading...</div>
    </div>
  </div>

  <script>
    function openDetails(id) {
      const modal = document.getElementById("detailsModal");
      const box = document.getElementById("detailsArea");

      modal.classList.add("open");
      box.innerHTML = "Loading...";

      fetch(`/officer/details/${id}`)
        .then(res => res.json())
        .then(d => {
          const attachmentsHtml = (d.attachments && d.attachments.length)
            ? d.attachments.map(a => `<a href="/uploads/${a.filename}" target="_blank">${a.originalName}</a>`).join(', ')
            : 'None';

          box.innerHTML = `
            <div class="detail-row"><b>Title:</b> ${d.title}</div>
            <div class="detail-row"><b>Category:</b> ${d.category}</div>
            <div class="detail-row"><b>Description:</b> ${d.description}</div>
            <div class="detail-row"><b>Priority:</b> ${d.priority}</div>
            <div class="detail-row"><b>Student:</b> ${d.anonymous ? "Anonymous" : (d.student?.name || "N/A")}</div>
            <div class="detail-row"><b>Status:</b> ${d.status}</div>
            <div class="detail-row"><b>Created:</b> ${new Date(d.createdAt).toLocaleString()}</div>
            <div class="detail-row"><b>Attachments:</b> ${attachmentsHtml}</div>

            <h4 style="margin-top:16px">Add Remark</h4>
            <form method="POST" action="/officer/remark">
              <input type="hidden" name="id" value="${d._id}">
              <textarea name="remark" placeholder="Enter your remark" required></textarea>
              <button class="btn" style="margin-top:8px;">Add Remark</button>
            </form>

            <h4 style="margin-top:16px">Remarks History</h4>
            ${(d.remarks && d.remarks.length > 0) ? d.remarks.map(r => `
              <div class="detail-row">
                <b>${r.by}</b> — ${new Date(r.at).toLocaleString()}<br>
                ${r.text}
              </div>
            `).join("") : "<div class='detail-row muted'>No remarks yet</div>"}
          `;
        });
    }

    function closeDetails() {
      document.getElementById("detailsModal").classList.remove("open");
    }
  </script>
</body>
</html>
