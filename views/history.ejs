<!doctype html>
<html lang="en">
<head>
  <title>Complaint History — VoiceUp</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>Complaint History</h1>
        <div class="sub"><%= complaints.length %> complaint<%= complaints.length === 1 ? '' : 's' %></div>
      </header>

      <div class="app-content" style="max-width:900px">
        <div class="card" style="margin-bottom:18px">
          <form method="POST" action="/complaint/quick" style="display:flex;gap:10px">
            <input type="text" name="query" placeholder="Search by title, category or description..." style="flex:1">
            <button class="btn" type="submit"><i class="bi bi-search"></i> Search</button>
          </form>
        </div>

        <% if (complaints.length === 0) { %>
          <div class="card empty-state">
            <i class="bi bi-inbox icon"></i>
            <h4>No complaints submitted yet</h4>
            <p>Use "Lodge Complaint" from the sidebar to file your first one.</p>
          </div>
        <% } %>

        <% complaints.forEach(c => { %>
          <div class="card" style="margin-bottom:14px">
            <div class="spread">
              <div>
                <div style="font-weight:700;font-size:15.5px;color:var(--ink)"><%= c.title %></div>
                <div class="meta small muted" style="margin-top:4px">
                  Ref: <%= c.referenceId %> &nbsp;|&nbsp; <%= c.category %> &nbsp;|&nbsp; Priority: <%= c.priority %>
                </div>
              </div>
              <div>
                <% if (c.status === 'Resolved') { %><span class="badge resolved">Resolved</span>
                <% } else if (c.status === 'In Process') { %><span class="badge inprocess">In Process</span>
                <% } else if (c.status === 'Escalated') { %><span class="badge escalated">Escalated</span>
                <% } else { %><span class="badge pending">Pending</span><% } %>
              </div>
            </div>

            <p style="margin-top:12px;font-size:14px"><%= c.description %></p>

            <% if (c.attachments && c.attachments.length) { %>
              <div class="file-chip-list">
                <% c.attachments.forEach(a => { %>
                  <a class="file-chip" href="/uploads/<%= a.filename %>" target="_blank">
                    <i class="bi bi-paperclip"></i> <%= a.originalName %>
                  </a>
                <% }) %>
              </div>
            <% } %>

            <div class="small muted" style="margin-top:10px">Submitted <%= new Date(c.createdAt).toLocaleString() %></div>

            <% if (c.status === 'Resolved') { %>
              <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--border-soft)">
                <% if (c.feedback && c.feedback.rating) { %>
                  <div class="small muted">Your rating:
                    <span class="star-rating readonly" style="vertical-align:middle">
                      <% for (let i = 1; i <= 5; i++) { %><span class="star <%= i <= c.feedback.rating ? 'filled' : '' %>">★</span><% } %>
                    </span>
                  </div>
                  <% if (c.feedback.comment) { %><p class="small muted" style="margin-top:4px">“<%= c.feedback.comment %>”</p><% } %>
                <% } else { %>
                  <form method="POST" action="/complaint/feedback/<%= c._id %>" class="feedback-form">
                    <div class="small muted" style="margin-bottom:6px">Rate how this was resolved:</div>
                    <input type="hidden" name="rating" class="rating-input" value="0">
                    <span class="star-rating">
                      <% for (let i = 1; i <= 5; i++) { %><span class="star" data-value="<%= i %>">★</span><% } %>
                    </span>
                    <input type="text" name="comment" placeholder="Optional comment" style="max-width:260px;display:inline-block;margin-left:10px;vertical-align:middle">
                    <button class="btn small" type="submit" style="margin-left:6px">Submit</button>
                  </form>
                <% } %>
              </div>
            <% } %>

            <div class="actions" style="margin-top:12px">
              <a href="javascript:void(0)" onclick="confirmDelete('<%= c._id %>')" style="color:#dc2626;font-size:13px;font-weight:600;text-decoration:none">
                <i class="bi bi-trash3"></i> Delete
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </div>

  <script>
    function confirmDelete(id) {
      if (confirm("Are you sure you want to delete this complaint?")) {
        window.location.href = "/complaint/delete/" + id;
      }
    }

    document.querySelectorAll('.feedback-form').forEach(form => {
      const stars = form.querySelectorAll('.star');
      const input = form.querySelector('.rating-input');
      stars.forEach(star => {
        star.addEventListener('click', () => {
          const val = Number(star.dataset.value);
          input.value = val;
          stars.forEach(s => s.classList.toggle('filled', Number(s.dataset.value) <= val));
        });
      });
      form.addEventListener('submit', e => {
        if (Number(input.value) < 1) {
          e.preventDefault();
          alert('Please select a star rating first.');
        }
      });
    });
  </script>
</body>
</html>
