<!doctype html>
<html lang="en">
<head>
  <title>Grievance Officer Login — VoiceUp</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="auth-icon"><i class="bi bi-person-badge"></i></div>
      <h2>Grievance Officer Login</h2>
      <p class="lead">Manage escalated complaints assigned to you</p>

      <form method="POST" action="/auth/login-officer">
        <div class="form-row">
          <label>Email</label>
          <input name="email" type="email" placeholder="officer@college.edu" required>
        </div>
        <div class="form-row">
          <label>Password</label>
          <input name="password" type="password" placeholder="Enter password" required>
        </div>
        <button class="btn" type="submit">Login</button>
      </form>

      <a class="auth-back" href="/">← Back to Home</a>
    </div>
  </div>
</body>
</html>
