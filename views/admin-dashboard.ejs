<!doctype html>
<html lang="en">
<head>
  <title>Admin Dashboard — VoiceUp</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>

    <main class="app-main">
      <header class="app-topbar">
        <h1>All Complaints</h1>
        <div class="sub"><%= total %> total</div>
      </header>

      <div class="app-content">
        <div class="stat-grid">
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon"><i class="bi bi-collection"></i></span>Total</div>
            <div class="stat-value"><%= total %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon" style="background:var(--pending-bg);color:var(--pending-fg)"><i class="bi bi-hourglass-split"></i></span>Pending</div>
            <div class="stat-value"><%= summary['Pending'] || 0 %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon" style="background:var(--inprocess-bg);color:var(--inprocess-fg)"><i class="bi bi-arrow-repeat"></i></span>In Process</div>
            <div class="stat-value"><%= summary['In Process'] || 0 %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon" style="background:var(--escalated-bg);color:var(--escalated-fg)"><i class="bi bi-arrow-up-circle"></i></span>Escalated</div>
            <div class="stat-value"><%= summary['Escalated'] || 0 %></div>
          </div>
          <div class="stat-tile">
            <div class="stat-label"><span class="stat-icon" style="background:var(--resolved-bg);color:var(--resolved-fg)"><i class="bi bi-check-circle"></i></span>Resolved</div>
            <div class="stat-value"><%= summary['Resolved'] || 0 %></div>
          </div>
        </div>

        <div class="grid-2">
          <section>
            <div class="card" style="margin-bottom:16px">
              <div class="row" style="margin-bottom:14px; flex-wrap:wrap; gap:8px">
                <a href="/admin/dashboard" class="btn <%= filter==='all'?'':'secondary' %> small">All</a>
                <a href="/admin/dashboard?filter=pending" class="btn <%= filter==='pending'?'':'secondary' %> small">Pending</a>
                <a href="/admin/dashboard?filter=inprocess" class="btn <%= filter==='inprocess'?'':'secondary' %> small">In Process</a>
                <a href="/admin/dashboard?filter=escalated" class="btn <%= filter==='escalated'?'':'secondary' %> small">Escalated</a>
                <a href="/admin/dashboard?filter=resolved" class="btn <%= filter==='resolved'?'':'secondary' %> small">Resolved</a>
              </div>

              <form method="GET" action="/admin/dashboard" style="display:flex;gap:10px">
                <input name="q" placeholder="Search by title, description or id..." value="<%= q %>" style="flex:1">
                <input type="hidden" name="filter" value="<%= filter %>">
                <button class="btn secondary"><i class="bi bi-search"></i></button>
              </form>
            </div>

            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr><th>Ref</th><th>Title</th><th>Category</th><th>Student</th><th>Status</th><th>Assigned</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <% if (complaints.length === 0) { %>
                    <tr><td colspan="7"><div class="empty-state"><i class="bi bi-inbox icon"></i><h4>No complaints found</h4></div></td></tr>
                  <% } %>
                  <% complaints.forEach(c => { %>
                    <tr>
                      <td style="min-width:130px">
                        <a href="/admin/complaints/<%= c._id %>" style="color:var(--primary);font-weight:600;text-decoration:none"><%= c.referenceId || c._id %></a>
                        <div class="small muted"><%= new Date(c.createdAt).toLocaleDateString() %></div>
                      </td>
                      <td style="min-width:200px">
                        <strong><%= c.title %></strong>
                        <div class="small muted"><%= (c.description||'').slice(0,90) %><%= c.description && c.description.length>90 ? '…' : '' %></div>
                      </td>
                      <td><%= c.category %></td>
                      <td><%= c.anonymous ? "Anonymous" : (c.student ? c.student.name : '—') %></td>
                      <td>
                        <% if (c.status === 'Resolved') { %><span class="badge resolved">Resolved</span>
                        <% } else if (c.status === 'In Process') { %><span class="badge inprocess">In Process</span>
                        <% } else if (c.status === 'Escalated') { %><span class="badge escalated">Escalated</span>
                        <% } else { %><span class="badge pending">Pending</span><% } %>
                      </td>
                      <td><%= c.assignedTo ? c.assignedTo.name : (c.assignedDepartment || '—') %></td>
                      <td>
                        <div class="row" style="flex-wrap:wrap;gap:6px">
                          <a href="/admin/complaints/<%= c._id %>" class="btn ghost small">View</a>
                          <form method="POST" action="/admin/resolve" style="display:inline">
                            <input type="hidden" name="id" value="<%= c._id %>">
                            <button class="btn small" type="submit">Resolve</button>
                          </form>
                          <form method="POST" action="/admin/escalate" style="display:inline">
                            <input type="hidden" name="id" value="<%= c._id %>">
                            <button class="btn secondary small" type="submit">Escalate</button>
                          </form>
                          <form method="POST" action="/admin/delete" style="display:inline" onsubmit="return confirm('Delete this complaint?')">
                            <input type="hidden" name="id" value="<%= c._id %>">
                            <button class="btn danger small" type="submit"><i class="bi bi-trash3"></i></button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div class="row" style="margin-top:16px;justify-content:flex-end">
              <% if (page > 1) { %><a href="?page=<%= page-1 %>&per=<%= per %>&filter=<%= filter %>&q=<%= encodeURIComponent(q) %>" class="btn secondary small">← Prev</a><% } %>
              <span class="small muted">Page <%= page %></span>
              <% if (total > page*per) { %><a href="?page=<%= page+1 %>&per=<%= per %>&filter=<%= filter %>&q=<%= encodeURIComponent(q) %>" class="btn secondary small">Next →</a><% } %>
            </div>
          </section>

          <aside>
            <div class="card">
              <h3>Quick Assign</h3>
              <form method="POST" action="/admin/assign">
                <div class="form-row">
                  <label>Complaint ID</label>
                  <input name="id" required>
                </div>
                <div class="form-row">
                  <label>Assign to Officer</label>
                  <select name="assignedTo">
                    <option value="">-- select officer --</option>
                    <% officers.forEach(o => { %>
                      <option value="<%= o._id %>"><%= o.name %> — <%= o.email %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-row">
                  <label>Or Department</label>
                  <input name="assignedDepartment" placeholder="e.g. Hostel">
                </div>
                <button class="btn" type="submit" style="width:100%">Assign</button>
              </form>
            </div>

            <div class="card" style="margin-top:16px">
              <h3>Export</h3>
              <a href="/admin/export/csv" class="btn secondary" style="width:100%"><i class="bi bi-download"></i> Export all complaints (CSV)</a>
            </div>
          </aside>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
